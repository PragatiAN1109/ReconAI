# Copy to .env to override Compose defaults. .env is gitignored — never commit
# a real key.
#
#   cp .env.example .env
#
# Everything here is optional; the stack runs with none of it set.

# --- Anthropic (optional) --------------------------------------------------
# With the provider left as "none", the stack runs normally and the
# investigation run endpoint reports 503. Set both to enable a real provider.
#
# ⚠️  Live investigations cost money. The key is read from the environment at
#     run time and is never baked into an image or written to Compose.
# RECONAI_AGENT_LLM_PROVIDER=anthropic
# RECONAI_AGENT_LLM_API_KEY=sk-ant-...
# RECONAI_AGENT_LLM_MODEL=claude-sonnet-5

# --- Host ports (optional) -------------------------------------------------
# Change only if one collides with something already running.
# RECONAI_POSTGRES_PORT=55432
# RECONAI_KAFKA_PORT=9092
# RECONAI_CORE_PORT=8099
# RECONAI_AGENT_HOST_PORT=8000
# RECONAI_FRONTEND_PORT=3000
