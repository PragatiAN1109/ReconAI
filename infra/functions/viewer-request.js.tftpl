// CloudFront viewer-request function. Rendered by Terraform (templatefile).
//
// Does three jobs, in this order, on every request to the distribution:
//   1. HTTP Basic Auth  — gates the whole demo
//   2. strips Authorization — so the credential never crosses the HTTP hop
//      from CloudFront to the ALB
//   3. rewrites the API prefix — /api/core -> /api/v1,
//      /api/investigation -> /api/v1
//
// All three live in ONE function because CloudFront permits only one
// viewer-request function per cache behaviour.
//
// The function never touches the request body. CloudFront Functions have no
// body access at all, so POST payloads pass through unmodified by construction
// rather than by care. Query strings live on request.querystring, which is left
// alone; only request.uri is rewritten.
//
// CloudFront Functions also have no network access, which is why the credential
// is embedded here at deploy time rather than fetched from SSM.

function handler(event) {
  var request = event.request;
  var headers = request.headers;

  // --- 1. Basic Auth -------------------------------------------------------
  var expected = "Basic ${basic_auth_b64}";

  if (!headers.authorization || headers.authorization.value !== expected) {
    return {
      statusCode: 401,
      statusDescription: "Unauthorized",
      headers: {
        "www-authenticate": { value: 'Basic realm="ReconAI Operations Console"' },
        "cache-control": { value: "no-store" }
      }
    };
  }

  // --- 2. Do not forward the credential to the origin ----------------------
  delete headers.authorization;

  // --- 3. Rewrite the API prefix ------------------------------------------
  // Both backends serve under /api/v1. The two browser-facing prefixes exist
  // to tell the services apart at the edge; they are collapsed here so no
  // backend source change is needed for AWS routing.
  var uri = request.uri;

  if (uri.indexOf("/api/core/") === 0) {
    request.uri = "/api/v1/" + uri.substring("/api/core/".length);
  } else if (uri.indexOf("/api/investigation/") === 0) {
    request.uri = "/api/v1/" + uri.substring("/api/investigation/".length);
  }
  // Anything else — the SPA shell, /assets/*, favicons — is left untouched.

  return request;
}
