# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# NO SECRETS BELONG IN THIS FILE, and none are needed:
#   · the database password is generated and held by RDS
#   · the Anthropic key lives in SSM, created by you, never read by Terraform
#
# Every value below is non-sensitive configuration.

aws_region   = "us-east-1"
project_name = "reconai"
environment  = "demo"

# Subdomain only. DNS stays at Namecheap; the apex is never touched.
domain_name = "reconai.pragatinarote.com"

# STAGE GATE. Leave false for the first apply.
#
# false -> foundation: VPC, RDS, ECR, ALB, S3, ACM, Cloud Map, IAM, logs
# true  -> adds CloudFront and starts the three ECS services
#
# Set true only after: images pushed, both SSM SecureStrings created, and the
# ACM validation CNAME added at Namecheap. See README.md.
deploy_app_services = false

# Parameter NAMES only. Terraform never creates or reads their values.
anthropic_key_parameter_name      = "/reconai/demo/anthropic-api-key"
agent_database_url_parameter_name = "/reconai/demo/agent-database-url"

# GitHub OIDC trust scoping.
github_owner = "PragatiAN1109"
github_repo  = "ReconAI"

# Set false and supply the ARN if this account already has a GitHub OIDC
# provider — an account may hold only one for token.actions.githubusercontent.com.
create_github_oidc_provider       = true
existing_github_oidc_provider_arn = ""

db_instance_class  = "db.t4g.micro"
log_retention_days = 7
image_tag          = "latest"
